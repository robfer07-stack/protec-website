# ---------------------------------------------------------------------------
# ProTec Dental Laboratory — Apache config for HostGator (shared hosting)
# Rename this file to ".htaccess" (with the leading dot) in public_html
# ONLY when this static site replaces the current WordPress site.
# WordPress also uses .htaccess — overwriting it while WordPress is still
# live will break WordPress. Back up the existing .htaccess first.
# ---------------------------------------------------------------------------

# Custom 404 page
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (enable SSL in cPanel > SSL/TLS Status first — HostGator gives a free cert)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Use the bare domain (www.proteclab.com.au -> proteclab.com.au)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Redirect old WordPress page URLs to the new pages (keeps Google links working)
  RewriteRule ^about-2/?$ /about.html [L,R=301]
  RewriteRule ^services-2/?$ /services.html [L,R=301]
  RewriteRule ^contact-2/?$ /contact.html [L,R=301]
</IfModule>

# Browser caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# Don't expose the git folder or docs if they get uploaded by accident
RedirectMatch 404 /\.git
<FilesMatch "^(README\.md|htaccess\.example)$">
  Require all denied
</FilesMatch>
